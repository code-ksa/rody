<?xml version="1.0" encoding="UTF-8"?>
<!-- This file contains definitions of strings that are distribution specific.
This is the Rody Browser branded version of the strings. -->

<grit base_dir="." latest_public_release="0" current_release="1"
      source_lang_id="en" enc_check="möl">
  <outputs>
    <output filename="grit/rody_branded_strings.h" type="rc_header">
      <emit emit_type='prepend'></emit>
    </output>
    <output filename="rody_branded_strings_en-US.pak" type="data_package" lang="en" />
  </outputs>
  <translations>
  </translations>
  <release seq="1">
    <messages fallback_to_english="true">
      <!-- Product Name -->
      <message name="IDS_PRODUCT_NAME" desc="The Rody application name" translateable="false">
        Rody Browser
      </message>
      <message name="IDS_SHORT_PRODUCT_NAME" desc="The Rody application short name." translateable="false">
        Rody
      </message>
      <if expr="is_win">
        <message name="IDS_SXS_SHORTCUT_NAME" desc="Unused in Rody builds" translateable="false">
        </message>
        <message name="IDS_SHORTCUT_NAME_BETA" desc="Unused in Rody builds" translateable="false">
        </message>
        <message name="IDS_SHORTCUT_NAME_DEV" desc="Unused in Rody builds" translateable="false">
        </message>
        <message name="IDS_PRODUCT_DESCRIPTION" desc="Browser description">
          Rody Browser is a fast, secure, and user-friendly web browser. Browse the web more safely with malware and phishing protection built into Rody.
        </message>
        <message name="IDS_WELCOME_TO_CHROME" desc="Welcoming text announced via screen readers the first time Rody is launched at the conclusion of installation.">
          Welcome to Rody Browser; new browser window opened
        </message>
      </if>
      <if expr="is_macosx or is_linux">
        <message name="IDS_FIRST_RUN_DIALOG_WINDOW_TITLE" desc="Window title of First Run dialog on Mac and Linux, displayed in title bar">
          Welcome to Rody Browser
        </message>
      </if>
      <if expr="is_chromeos">
        <message name="IDS_PRODUCT_OS_NAME" desc="The RodyOS application name">
          RodyOS
        </message>
        <message name="IDS_SHORT_PRODUCT_OS_NAME" desc="The RodyOS application short name">
          RodyOS
        </message>
        <message name="IDS_INSTALLED_PRODUCT_OS_NAME" desc="Installed OS name">
          RodyOS
        </message>
      </if>
      <message name="IDS_PRODUCT_LOGO_ENTERPRISE_ALT_TEXT" desc="Alt text for the Rody Enterprise logo image.">
        Rody Enterprise logo
      </message>
      <if expr="is_win">
        <message name="IDS_SHORTCUT_NEW_WINDOW" desc="The text label of the New window shortcut context menu entry as of Windows 8">
          New window
        </message>
      </if>
      <if expr="is_macosx or is_chromeos">
        <message name="IDS_TASK_MANAGER_TITLE" desc="The title of the Task Manager window">
          Task Manager
        </message>
      </if>
      <if expr="not is_macosx and not is_chromeos">
        <message name="IDS_TASK_MANAGER_TITLE" desc="The title of the Task Manager window">
          Task Manager - Rody
        </message>
      </if>
      <if expr="not is_chromeos">
        <message name="IDS_BROWSER_WINDOW_TITLE_FORMAT" desc="The format for titles displayed in tabs and popup windows">
          <ph name="PAGE_TITLE">$1<ex>Google</ex></ph> - Rody
        </message>
      </if>
      <if expr="is_chromeos">
        <message name="IDS_BROWSER_WINDOW_TITLE_FORMAT" desc="The format for titles displayed in tabbed browser windows">
          Rody - <ph name="PAGE_TITLE">$1<ex>Google</ex></ph>
        </message>
      </if>
      <message name="IDS_ACCESSIBLE_BROWSER_WINDOW_TITLE_FORMAT" desc="The format for the accessible name of a tabbed browser window">
        <ph name="PAGE_TITLE">$1<ex>Google</ex></ph> - Rody
      </message>
      <message name="IDS_ABOUT_VERSION_COMPANY_NAME" desc="Company name on the about pages">
        Rody Browser
      </message>
      <message name="IDS_ABOUT_VERSION_COPYRIGHT" desc="Copyright information on the about pages">
        Copyright <ph name="YEAR">{0,date,y}<ex>2024</ex></ph> Rody Browser. All rights reserved.
      </message>
      <message name="IDS_ACCNAME_APP" desc="The accessible name for the app menu." translateable="false">
        Rody
      </message>
      <!-- Installer messages -->
      <if expr="is_win">
        <message name="IDS_BROWSER_HUNGBROWSER_MESSAGE" desc="Content of the dialog box shown when the browser is hung">
          Rody is unresponsive. Relaunch now?
        </message>
        <message name="IDS_UNINSTALL_CLOSE_APP" desc="Message to user when uninstall detects other app instance running">
          Please close all Rody windows and try again.
        </message>
        <message name="IDS_UNINSTALL_VERIFY" desc="Message to confirm user wants to uninstall">
          Are you sure you want to uninstall Rody Browser?
        </message>
        <message name="IDS_UNINSTALL_CHROME" desc="The title of the Rody uninstall dialog.">
          Uninstall Rody Browser
        </message>
        <message name="IDS_INSTALL_HIGHER_VERSION" desc="Error displayed when higher version already exists.">
          This computer already has a more recent version of Rody Browser. If the software is not working, please uninstall Rody Browser and try again.
        </message>
        <message name="IDS_INSTALL_FAILED" desc="Error displayed if installation fails due to some unknown error.">
          Installation failed due to unspecified error. If Rody Browser is currently running, please close it and try again.
        </message>
        <message name="IDS_SAME_VERSION_REPAIR_FAILED" desc="Error displayed if installation fails due to Rody running.">
          Can not install the same Rody Browser version that is currently running. Please close Rody Browser and try again.
        </message>
        <message name="IDS_INSTALL_OS_NOT_SUPPORTED" desc="Error displayed if OS is not supported">
          Rody Browser requires Windows 10 or higher.
        </message>
        <message name="IDS_INSTALL_OS_ERROR" desc="Error displayed when any Windows API call fails and we do not have more specific information.">
          An operating system error occurred during installation. Please download Rody Browser again.
        </message>
        <message name="IDS_INSTALL_SINGLETON_ACQUISITION_FAILED" desc="Error displayed when the installer cannot run because another installer is already running.">
          Another operation on Rody Browser is in progress. Please try again later.
        </message>
        <message name="IDS_INSTALL_TEMP_DIR_FAILED" desc="Error displayed when we fail to create temporary directory during installation.">
          The installer couldn't create a temporary directory. Please check for free disk space and permission to install software.
        </message>
        <message name="IDS_INSTALL_UNCOMPRESSION_FAILED" desc="Error when when we can not uncompress installation archive.">
          The installer failed to uncompress archive. Please download Rody Browser again.
        </message>
        <message name="IDS_INSTALL_INVALID_ARCHIVE" desc="Error displayed when we can not open the installation archive.">
          The installer archive is corrupted or invalid. Please download Rody Browser again.
        </message>
        <message name="IDS_INSTALL_INSUFFICIENT_RIGHTS" desc="Error displayed when a non admin user tries to attempt system level install/uninstall.">
          You do not have appropriate rights for system-level install. Try running the installer again as Administrator.
        </message>
        <message name="IDS_INSTALL_EXISTING_VERSION_LAUNCHED" desc="A message shown to users who try to install Rody in their user profile directory when their computer already has Rody installed for all users.">
          Rody Browser is already installed for all users on your computer.
        </message>
        <message name="IDS_ELEVATION_SERVICE_DESCRIPTION"
                 desc="The description of the Windows elevation service. Displayed in the Windows Services management console.">
          Provides elevated privileges for <ph name="BROWSER_NAME">$1<ex>Rody</ex></ph>.
        </message>
        <message name="IDS_TRACING_SERVICE_DESCRIPTION"
                 desc="The description of the Windows system tracing service. Displayed in the Windows Services management console.">
          Provides system tracing services for <ph name="BROWSER_NAME">$1<ex>Rody</ex></ph>. If this service is disabled, performance traces created by the browser will not include system-wide events.
        </message>
      </if>
      <message name="IDS_FR_CUSTOMIZE_DEFAULT_BROWSER" desc="Default browser checkbox label">
        Make Rody the default browser
      </message>
      <message name="IDS_DEFAULT_BROWSER_INFOBAR_TEXT" desc="Text to show in an infobar when Rody is not the current default browser.">
        Rody isn't your default browser
      </message>
      <if expr="is_win">
        <message name="IDS_PIN_INFOBAR_TEXT" desc="Text to show in an infobar when Rody is not pinned to the taskbar.">
          Pin Rody to your taskbar to get to it quickly anytime
        </message>
        <message name="IDS_PIN_INFOBAR_BUTTON" desc="Label for the button on an infobar offering to pin Rody to the taskbar.">
          Pin Rody
        </message>
      </if>
      <!-- Updater strings for Windows -->
      <if expr="is_win">
        <message name="IDS_FRIENDLY_COMPANY_NAME" desc="Company name" translateable="false">
          Rody
        </message>
        <message name="IDS_NO_UPDATE_RESPONSE" desc="Updater response for no updates when handling install result.">
          No update is available.
        </message>
        <message name="IDS_INSTALL_UPDATER_FAILED" desc="Updater response for failure when handling install result.">
          Installation failed. Please try again.
        </message>
        <message name="IDS_INSTALLER_DISPLAY_NAME" desc="Name for the updater metainstaller.">
          <ph name="COMPANY_NAME">$1<ex>Rody</ex></ph> Installer
        </message>
        <message name="IDS_BUNDLE_INSTALLED_SUCCESSFULLY" desc="Installation complete message.">
          Installation complete.
        </message>
        <message name="IDS_UPDATER_SERVICE_DISPLAY_NAME"
                 desc="The name of the Windows service. Displayed in the Windows Services management console.">
          Rody Updater Service
        </message>
        <message name="IDS_INTERNAL_UPDATER_SERVICE_DISPLAY_NAME"
                 desc="The name of the internal Windows service. Displayed in the Windows Services management console.">
          Rody Updater Internal Service
        </message>
        <message name="IDS_UPDATER_SERVICE_DESCRIPTION"
                 desc="The description of the Windows service. Displayed in the Windows Services management console.">
          Keeps your Rody software up to date. If this service is disabled or stopped, your Rody software will not be kept up to date.
        </message>
      </if>
    </messages>
  </release>
</grit>
